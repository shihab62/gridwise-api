# Server Configuration
PORT=8000

# LLM Configuration (Provider-Agnostic)
# Supported LLM_PROVIDER: "gemini", "openai", "groq", "openrouter"
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Fallback & Heuristic Configuration
ENABLE_HEURISTIC_FALLBACK=true

# Alternative direct Gemini API Key fallback if LLM_API_KEY is not set
GEMINI_API_KEY=
